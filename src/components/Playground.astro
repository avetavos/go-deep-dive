---
import { Code } from 'astro-expressive-code/components';

interface Props {
  code: string;
  lang?: string;
}

const { code, lang = 'go' } = Astro.props;
---

<div class="pg not-content" data-code={code}>
  <div class="pg__bar">
    <button class="pg__run" data-run type="button">Run ▸</button>
    <a class="pg__run" data-open href="https://go.dev/play/" target="_blank" rel="noopener">Open in Playground</a>
  </div>
  <Code code={code} lang={lang} />
  <p class="pg__hint" data-hint hidden></p>
  <pre class="pg__err" data-err hidden><code></code></pre>
  <pre class="pg__out" data-out hidden><code></code></pre>
</div>

<script>
  import { runGo } from './go-runner';

  const TH = document.documentElement.lang?.startsWith('th');
  const T = TH
    ? {
        run: 'รัน ▸',
        running: 'กำลังรัน…',
        hint: 'กำลัง compile บน go.dev (Go 1.27)… ถ้าออฟไลน์ จะใช้ runtime ในเบราว์เซอร์แทน (~8 MB, Go 1.26)',
        noOutput: '(ไม่มี output)',
        failed: 'รันไม่สำเร็จ — ลองกด "Open in Playground"',
        copied: 'คัดลอกแล้ว — วางในหน้า playground',
      }
    : {
        run: 'Run ▸',
        running: 'Running…',
        hint: 'Compiling on go.dev (Go 1.27)… offline? an in-browser runtime (~8 MB, Go 1.26) is used instead',
        noOutput: '(no output)',
        failed: 'Run failed — try "Open in Playground".',
        copied: 'Copied — paste it into the playground',
      };

  document.querySelectorAll<HTMLElement>('.pg').forEach((pg) => {
    if (pg.dataset.wired) return;
    pg.dataset.wired = '1';

    const code = pg.dataset.code || '';
    const runBtn = pg.querySelector<HTMLButtonElement>('[data-run]');
    const openBtn = pg.querySelector<HTMLAnchorElement>('[data-open]');
    const hint = pg.querySelector<HTMLElement>('[data-hint]');
    const errBox = pg.querySelector<HTMLElement>('[data-err]');
    const outBox = pg.querySelector<HTMLElement>('[data-out]');
    if (hint) hint.textContent = T.hint;
    if (runBtn) runBtn.textContent = T.run;

    openBtn?.addEventListener('click', () => {
      navigator.clipboard?.writeText(code);
      const label = openBtn.textContent;
      openBtn.textContent = T.copied;
      setTimeout(() => {
        openBtn.textContent = label;
      }, 2500);
    });

    runBtn?.addEventListener('click', async () => {
      runBtn.disabled = true;
      runBtn.textContent = T.running;
      if (hint) hint.hidden = false;
      if (errBox) errBox.hidden = true;
      if (outBox) outBox.hidden = true;
      try {
        const data = await runGo(code);
        if (data.errors && errBox) {
          errBox.querySelector('code')!.textContent = data.errors;
          errBox.hidden = false;
        }
        if (outBox) {
          outBox.querySelector('code')!.textContent = (data.output ?? '') || T.noOutput;
          outBox.hidden = false;
        }
      } catch {
        if (errBox) {
          errBox.querySelector('code')!.textContent = T.failed;
          errBox.hidden = false;
        }
      } finally {
        runBtn.disabled = false;
        runBtn.textContent = T.run;
        if (hint) hint.hidden = true;
      }
    });
  });
</script>
